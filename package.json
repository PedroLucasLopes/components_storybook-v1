{
  "name": "@pedrolucaslopes/dotlog-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Componentes Vuetify, tema e Storybook compartilhados pelos fronts do ecossistema SSO.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroLucasLopes/storybook-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@mdi/font": "7.4.47",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "sass-embedded": "^1.98.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5",
    "vuetify": "^4.0.2"
  }
}
