{
  "name": "@pedrolucaslopes/dotlog-ui",
  "version": "0.6.1",
  "type": "module",
  "description": "Componentes Vuetify, tema e Storybook compartilhados pelos fronts do ecossistema SSO.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroLucasLopes/components_storybook-v1.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepublishOnly": "npm run check:locales && npm run type-check && npm run build",
    "check:locales": "node scripts/check-locales.mjs src/i18n/locales"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vuetify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mdi/font": "7.4.47",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass-embedded": "^1.107.1",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.18",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.2"
  }
}
